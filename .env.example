RATE_LIMITING_ENABLE=false
RATE_LIMITING_FREQUENCY=2/3seconds
# Enable only behind a proxy that overwrites client-supplied Fly-Client-IP (e.g. Fly.io).
TRUST_PROXY_HEADERS=false
TFMKT_BASE_URL=https://tmapi.transfermarkt.technology
TFMKT_TIMEOUT_SECONDS=15
TFMKT_MAX_CONCURRENCY=10
CACHE_TTL_SECONDS=600
CACHE_REFERENCE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=2000
